<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.orbitworkbench.workflow.infrastructure.mapper.WorkflowNodeMapper">

    <resultMap id="NodeResultMap"
               type="com.orbitworkbench.workflow.domain.WorkflowNodeRecord">
        <id property="id" column="id"/>
        <result property="workflowVersionId" column="workflow_version_id"/>
        <result property="nodeKey" column="node_key"/>
        <result property="nodeType" column="node_type"/>
        <result property="name" column="name"/>
        <result property="configJson" column="config_json"/>
        <result property="positionJson" column="position_json"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert"
            parameterType="com.orbitworkbench.workflow.domain.WorkflowNodeRecord"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO workflow_node (
            workflow_version_id, node_key, node_type, name,
            config_json, position_json, created_at, updated_at
        ) VALUES (
            #{workflowVersionId}, #{nodeKey}, #{nodeType}, #{name},
            #{configJson}, #{positionJson}, #{createdAt}, #{updatedAt}
        )
    </insert>

    <select id="findByVersionId" resultMap="NodeResultMap">
        SELECT id, workflow_version_id, node_key, node_type, name,
               config_json, position_json, created_at, updated_at
        FROM workflow_node
        WHERE workflow_version_id = #{workflowVersionId}
        ORDER BY id
    </select>

    <delete id="deleteByVersionId">
        DELETE FROM workflow_node
        WHERE workflow_version_id = #{workflowVersionId}
    </delete>
</mapper>
