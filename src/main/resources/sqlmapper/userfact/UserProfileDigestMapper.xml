<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.orbitworkbench.userfact.infrastructure.mapper.UserProfileDigestMapper">
    <resultMap id="DigestMap" type="com.orbitworkbench.userfact.domain.UserProfileDigestRecord">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="digest" column="digest"/>
        <result property="sourceFactIds" column="source_fact_ids"/>
        <result property="sourceCount" column="source_count"/>
        <result property="model" column="model"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="allColumns">
        id, user_id, digest, source_fact_ids, source_count, model, created_at, updated_at
    </sql>

    <select id="findByUser" resultMap="DigestMap">
        SELECT <include refid="allColumns"/>
        FROM user_profile_digest
        WHERE user_id = #{userId}
    </select>

    <insert id="upsert" parameterType="com.orbitworkbench.userfact.domain.UserProfileDigestRecord"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_profile_digest(
            user_id, digest, source_fact_ids, source_count, model, created_at, updated_at
        )
        VALUES(
            #{userId}, #{digest}, #{sourceFactIds}, #{sourceCount}, #{model}, #{createdAt}, #{updatedAt}
        )
        ON DUPLICATE KEY UPDATE
            digest = VALUES(digest),
            source_fact_ids = VALUES(source_fact_ids),
            source_count = VALUES(source_count),
            model = VALUES(model),
            updated_at = VALUES(updated_at)
    </insert>

    <delete id="deleteByUser">
        DELETE FROM user_profile_digest
        WHERE user_id = #{userId}
    </delete>
</mapper>
