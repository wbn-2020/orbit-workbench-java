<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.orbitworkbench.userfact.infrastructure.mapper.UserFocusNoteMapper">
    <resultMap id="FocusMap" type="com.orbitworkbench.userfact.domain.UserFocusNoteRecord">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="content" column="content"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="allColumns">
        id, user_id, content, expires_at, created_at, updated_at
    </sql>

    <select id="findByUser" resultMap="FocusMap">
        SELECT <include refid="allColumns"/>
        FROM user_focus_note
        WHERE user_id = #{userId}
    </select>

    <insert id="upsert" parameterType="com.orbitworkbench.userfact.domain.UserFocusNoteRecord"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_focus_note(user_id, content, expires_at, created_at, updated_at)
        VALUES(#{userId}, #{content}, #{expiresAt}, #{createdAt}, #{updatedAt})
        ON DUPLICATE KEY UPDATE
            content = VALUES(content),
            expires_at = VALUES(expires_at),
            updated_at = VALUES(updated_at)
    </insert>

    <delete id="deleteByUser">
        DELETE FROM user_focus_note
        WHERE user_id = #{userId}
    </delete>
</mapper>
